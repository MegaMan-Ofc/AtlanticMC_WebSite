LimitRequestBody 1048576
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ /%1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+(.*/)?(ranks|rubis|keys|boosters|cart|checkout|login|success|privacy|terms|purchase-policy|rules|admin)\.php(?:[?\s]) [NC]
    RewriteRule ^(ranks|rubis|keys|boosters|cart|checkout|login|success|privacy|terms|purchase-policy|rules|admin)\.php$ /%1%2 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+(.*/)?index/?(?:[?\s]) [NC]
    RewriteRule ^index/?$ /%1 [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+(.*/)?(ranks|rubis|keys|boosters|cart|checkout|login|success|privacy|terms|purchase-policy|rules|admin)/+(?:[?\s]) [NC]
    RewriteRule ^(ranks|rubis|keys|boosters|cart|checkout|login|success|privacy|terms|purchase-policy|rules|admin)/$ /%1%2 [R=301,L,NE]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^(ranks|rubis|keys|boosters|cart|checkout|login|success|privacy|terms|purchase-policy|rules|admin)$ $1.php [END,QSA]
</IfModule>

<FilesMatch "^(?:\.env|\.env\.example|README-PHP\.md|CLEAN-URLS\.md|ADMIN-SETUP\.md|plan\.(?:txt|md))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always unset X-Powered-By
</IfModule>
