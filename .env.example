APP_NAME="Atlantic SMP"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false
# Comma-separated trusted proxy IPs or CIDR ranges. Leave empty when no reverse proxy is used.
TRUSTED_PROXIES=
PAYMENTS_ENABLED=false
APP_TIMEZONE=Europe/Lisbon
APP_DEFAULT_LANGUAGE=pt
SERVER_IP=play.atlanticeu.online
# Bedrock normally uses the same hostname and Geyser UDP port. Adjust these values to the real server configuration.
BEDROCK_SERVER_IP=play.atlanticeu.online
BEDROCK_SERVER_PORT=19132
# Must match Floodgate username-prefix exactly. Empty is valid when Floodgate has no prefix.
BEDROCK_USERNAME_PREFIX=
DISCORD_URL=https://discord.gg/atlanticnetwork
SUPPORT_EMAIL=support@atlantic.net
STORE_CURRENCY=EUR
VAT_RATE=0.23
MAX_CART_QUANTITY=20
ALLOW_TEST_ORDERS=true
APP_LOG_PATH=storage/app.log
SECURITY_LOG_PATH=storage/security.log

# Complete these fields before publishing the legal pages in production.
LEGAL_OPERATOR_NAME="Atlantic SMP"
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_TAX_ID=
LEGAL_COUNTRY=Portugal
PRIVACY_EMAIL=support@atlantic.net
LEGAL_LAST_UPDATED=2026-08-15

DB_DRIVER=sqlite
DB_PATH=storage/store.sqlite
# MySQL/MariaDB configuration for production.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=atlantic_store
# DB_USER=atlantic_user
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_CONNECT_TIMEOUT=5

TEBEX_PUBLIC_TOKEN=
TEBEX_WEBHOOK_SECRET=
TEBEX_VERIFY_WEBHOOK_AMOUNT=true
TEBEX_COUPONS_ENABLED=false
# Optional: comma-separated IP allowlist from the current Tebex webhook documentation.
TEBEX_ALLOWED_WEBHOOK_IPS=

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TIMEOUT=1800
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
