APP_NAME="Atlantic Anarchy"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Lisbon
APP_AUTO_MIGRATE=true
SERVER_IP=atlanticmc.secure.pebble.host
DISCORD_URL=https://discord.gg/atlanticnetwork
SUPPORT_EMAIL=support@atlantic.net
STORE_CURRENCY=EUR
VAT_RATE=0.23
MAX_CART_QUANTITY=20
ALLOW_TEST_ORDERS=true

DB_DRIVER=sqlite
DB_PATH=storage/store.sqlite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=atlantic_store
# DB_USER=atlantic_user
# DB_PASSWORD=change-me
# DB_CHARSET=utf8mb4

TEBEX_PUBLIC_TOKEN=
TEBEX_WEBHOOK_SECRET=
TEBEX_VERIFY_WEBHOOK_AMOUNT=true
# Optional: comma-separated IP allowlist from the current Tebex webhook documentation.
TEBEX_ALLOWED_WEBHOOK_IPS=

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
