# Server Configuration
PORT=3000
NODE_ENV=production

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# Altere para 'live' quando for para produção

# MBWay Configuration (usando EUPAGO ou similar)
MBWAY_API_KEY=your_mbway_api_key
MBWAY_API_URL=https://api.eupago.pt/v1.02

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=atlantic_store

# Minecraft Server Configuration
MC_SERVER_HOST=localhost
MC_SERVER_PORT=25575
MC_RCON_PASSWORD=your_rcon_password

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this
WEBHOOK_SECRET=your_webhook_secret_key

# Frontend URL
FRONTEND_URL=http://localhost:8080
